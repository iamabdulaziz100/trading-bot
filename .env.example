# Copy this file to .env (it is git-ignored) and fill in your MT5 account.
# Leave the values empty to use whatever account is already logged in to the MT5 terminal.
MSC_MT5_LOGIN=
MSC_MT5_PASSWORD=
# Exact server name as shown in MT5 (File → Login to Trade Account), e.g. "Broker-Demo"
MSC_MT5_SERVER=
# Optional: full path to terminal64.exe (only needed if several MT5 terminals are installed)
MSC_MT5_PATH=
